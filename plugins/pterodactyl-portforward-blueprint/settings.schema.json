{
  "fields": [
    {
      "key": "enabled",
      "type": "boolean",
      "label": "Enable extension",
      "default": false,
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "router_host",
      "type": "string",
      "label": "Router host",
      "default": "192.168.5.1",
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "router_ssh_user",
      "type": "string",
      "label": "SSH user",
      "default": "pterofwd",
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "ssh_connect_host",
      "type": "string",
      "label": "SSH connect host",
      "description": "Use astracap when a drop-in ssh_config defines that Host alias.",
      "default": "astracap",
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "ssh_kex_algorithms",
      "type": "string",
      "label": "SSH KEX algorithms",
      "description": "Cisco IOS 15.x needs +diffie-hellman-group14-sha1 (OpenSSH 10+ dropped group-exchange-sha1).",
      "default": "+diffie-hellman-group14-sha1",
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "ssh_host_key_algorithms",
      "type": "string",
      "label": "SSH host key algorithms",
      "default": "+ssh-rsa",
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "ssh_pubkey_accepted_algorithms",
      "type": "string",
      "label": "SSH pubkey accepted algorithms",
      "default": "+ssh-rsa",
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "ssh_ciphers",
      "type": "string",
      "label": "SSH ciphers",
      "description": "Optional. Leave blank unless required for older Cisco devices.",
      "default": "",
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "ssh_config_file",
      "type": "string",
      "label": "SSH config file path",
      "description": "Overridden by PORTFORWARD_SSH_CONFIG_FILE when set.",
      "default": "",
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "ssh_config_content",
      "type": "string",
      "label": "Inline SSH config",
      "description": "Used when no config file path is available.",
      "default": "",
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "ssh_extra_options",
      "type": "string",
      "label": "Extra SSH -o options",
      "description": "One OpenSSH option per line (without -o prefix).",
      "default": "",
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "router_ssh_private_key",
      "type": "password",
      "label": "SSH private key",
      "description": "Prefer mounting via sops at PORTFORWARD_SSH_KEY_FILE instead of storing in settings.",
      "sensitive": true,
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "wan_interface",
      "type": "string",
      "label": "WAN interface",
      "default": "GigabitEthernet0/0",
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "dry_run",
      "type": "boolean",
      "label": "Dry-run mode",
      "description": "Log IOS commands without applying them on the router.",
      "default": true,
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "auto_forward_on_install",
      "type": "boolean",
      "label": "Auto-forward on install",
      "default": false,
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "auto_remove_on_delete",
      "type": "boolean",
      "label": "Auto-remove on delete",
      "default": true,
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "allowed_port_min",
      "type": "integer",
      "label": "Allowed port min",
      "default": 1024,
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "allowed_port_max",
      "type": "integer",
      "label": "Allowed port max",
      "default": 65535,
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "blocked_ports",
      "type": "list",
      "label": "Blocked ports",
      "default": [22, 80, 443, 3380],
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "node_ip_map",
      "type": "json",
      "label": "Node IP map",
      "description": "Pterodactyl node ID to LAN IP mapping.",
      "default": {},
      "surfaces": ["admin"],
      "storage": "config"
    },
    {
      "key": "max_mappings_per_server",
      "type": "integer",
      "label": "Max mappings per server",
      "default": 8,
      "surfaces": ["admin"],
      "storage": "config"
    }
  ]
}
