# Example env for scripts/nextcloud-migrate/migrate.py
# Store secrets in sops on ace (never commit). sops-nix can expose:
#   /run/secrets/nextcloud-migrate-env
#
# Local dev: migrate.py config init → edit ~/.config/nextcloud-migrate/env

# Required
RCLONE_CONFIG=/run/nextcloud-migrate/rclone.conf
NEXTCLOUD_USER=prestonhager
NEXTCLOUD_URL=https://cloud.prestonhager.com

# iCloud (app-specific password on Linux — see README)
ICLOUD_APPLE_ID=prestonhager@icloud.com
ICLOUD_PASSWORD=

# iCloud destinations under /remote.php/dav/files/USER/
ICLOUD_FILES_DEST=iCloud Drive
ICLOUD_PHOTOS_DEST=Photos/iCloud
ICLOUDPD_DOWNLOAD_DIR=photos-staging
RCLONE_REMOTE_ICLOUD=icloud
RCLONE_REMOTE_NEXTCLOUD=nextcloud

# OneDrive files migration (optional overrides)
# ONEDRIVE_FILES_PATH=
# ONEDRIVE_FILES_DEST=OneDrive
# ONEDRIVE_FILES_EXCLUDE=Pictures/**,Photos/**,Camera Roll/**

# OneDrive photos → Nextcloud Photos/
# ONEDRIVE_PHOTO_MAPPINGS=Pictures/Camera Roll:Photos/Camera Roll,Pictures:Photos
