{ config, pkgs, lib ? pkgs.lib, inputs, ... }:

let
  sops-path = builtins.toString inputs.nix-secrets;
  # NOTE: only enable this upgrade option if you are upgrading mediawiki
  # you should add the following to your main installations LocalSettings.php
  #   $adminTask = ( PHP_SAPI === 'cli' || defined( 'MEDIAWIKI_INSTALL' ) );
  #   $wgReadOnly = $adminTask ? false : 'Upgrading to MediaWiki 1.44.0';
  # then download the latest mediawiki tarball and extract it to
  # /mw/mediawiki-<version>, move all of the necessary files
  # see https://www.mediawiki.org/wiki/Manual:Upgrading#Other_files
  # then enable the upgrade option and run the upgrade script inside the upgrade
  # container (not the main container)
  #   sudo podman exec mediawiki-upgrade php maintenance/run.php update
  # if all goes well, you can then move the new mediawiki-<verion> into /mw/html
  # and delete or backup the old mediawiki directory
  # make sure to disable the upgrade option after as well!
  mediawiki = {
    # Set homelab.mediawiki.enableUpgrade = true; it also turns on the
    # upgrade.loftiawiki.org vhost, its /etc/hosts entry and its probe.
    enableUpgrade = config.homelab.mediawiki.enableUpgrade;
    upgradeVersion = "1.45.6";
    version = "1.45.6";
    # Run nix-shell -p nix-prefetch-docker --run "nix-prefetch-docker --image-name mediawiki --image-tag <VERSION>-fpm-alpine"
    # then paste the nix data below when upgrading version
    dockerImage = {
      imageName = "mediawiki";
      imageDigest = "sha256:1008cceff943ba9e9cb8f2d2fcce3f818580743ae303b888fc0ea2ee54e6cedf";
      hash = "sha256-blpT1u9cRs57FDPk8TpGGcAObRQh8LaNB3YKPJe4lZA=";
      finalImageName = "mediawiki";
      finalImageTag = "1.45.6-fpm-alpine";
    };
    upgradeDockerImage = {
      imageName = "mediawiki";
      imageDigest = "sha256:1008cceff943ba9e9cb8f2d2fcce3f818580743ae303b888fc0ea2ee54e6cedf";
      hash = "sha256-blpT1u9cRs57FDPk8TpGGcAObRQh8LaNB3YKPJe4lZA=";
      finalImageName = "mediawiki";
      finalImageTag = "1.45.6-fpm-alpine";
    };
  };
  # Valkey requires a password. It is generated once on the host (no nix-secrets entry)
  # and handed to Valkey as a config file and to MediaWiki as MW_REDIS_PASSWORD, so it
  # never appears on a command line.
  redisAuthDir = "/var/lib/redis-auth/mediawiki";
  redisAuthScript = pkgs.writeShellScript "mediawiki-redis-auth" ''
    set -euo pipefail
    umask 077
    dir=${redisAuthDir}
    install -d -m 0700 /var/lib/redis-auth "$dir"
    if [ ! -s "$dir/password" ]; then
      od -An -tx1 -N32 /dev/urandom | tr -d ' \n' > "$dir/password.tmp"
      mv -f "$dir/password.tmp" "$dir/password"
    fi
    pw="$(cat "$dir/password")"
    printf 'requirepass %s\n' "$pw" > "$dir/valkey.conf.tmp"
    chown 10005:10005 "$dir/valkey.conf.tmp"
    chmod 0400 "$dir/valkey.conf.tmp"
    mv -f "$dir/valkey.conf.tmp" "$dir/valkey.conf"
    printf 'MW_REDIS_PASSWORD=%s\nREDISCLI_AUTH=%s\n' "$pw" "$pw" > "$dir/app.env.tmp"
    mv -f "$dir/app.env.tmp" "$dir/app.env"

    # LocalSettings.php is site state under /mw/html, not managed by Nix. Append the
    # password lookup once (idempotent marker); later assignments override the
    # $wgObjectCaches / $wgJobTypeConf blocks defined earlier in the file.
    ls=/mw/html/LocalSettings.php
    if [ -f "$ls" ] && ! grep -q 'ace-redis-auth' "$ls"; then
      cat >> "$ls" <<'EOF'

# ace-redis-auth: Valkey requires a password, generated by nixos/containers/mediawiki.nix
# and passed to the container as MW_REDIS_PASSWORD. Keep this after the Redis settings.
$wgObjectCaches['redis']['password'] = getenv( 'MW_REDIS_PASSWORD' ) ?: null;
$wgJobTypeConf['default']['redisConfig']['password'] = getenv( 'MW_REDIS_PASSWORD' ) ?: null;
EOF
    fi
  '';
in
{
  # Declared through imports so the rest of this file can stay a plain config
  # module. Read by nixos/caddy/mediawiki.nix and nixos/local-service-hosts.nix.
  imports = [
    {
      options.homelab.mediawiki.enableUpgrade = lib.mkEnableOption
        "the mediawiki-upgrade staging pod and the upgrade.loftiawiki.org vhost";
    }
  ];

  # declare any secrets such as passwords
  sops.secrets = {
    "mediawiki-environment" = {
      sopsFile = "${sops-path}/secrets/containers/mediawiki.yaml";
    };
  };

  # Create the mediawiki user and group
  users.users = {
    www-data = {
      isSystemUser = true;
      group = "www-data";
      # Not in the podman group: /run/podman/podman.sock is root:podman 0660, so that
      # would make every PHP worker root-equivalent. Nothing on the host runs podman
      # as www-data (the occ/cron units run as root and use `podman exec -u www-data`).
    };
    mysql = {
      isSystemUser = true;
      group = "mysql";
      extraGroups = [ "www-data" ];
    };
    daemon = {
      isSystemUser = true;
      group = "daemon";
    };
    # Dedicated ids for the database and cache containers.
    #
    # These containers used to run as 999:999, which on ace is not free:
    # uid 999 is nm-iodine and gid 999 is nscd. The tmpfiles rules below used
    # to name those accounts literally, so /mw/data and /mw/redis ended up
    # owner-writable by iodine and group-writable by nscd. Pin them into the
    # 10000+ band instead, which NixOS's allocator never hands out here.
    "mediawiki-db" = {
      isSystemUser = true;
      group = "mediawiki-db";
      uid = 10004;
    };
    "mediawiki-redis" = {
      isSystemUser = true;
      group = "mediawiki-redis";
      uid = 10005;
    };
  };
  users.groups = {
    www-data = {};
    mysql = {};
    daemon = {};
    # Same as nextcloud: match the containers' numeric "10004:10004" / "10005:10005".
    "mediawiki-db" = { gid = 10004; };
    "mediawiki-redis" = { gid = 10005; };
  };

  # Create the data directory
  systemd.tmpfiles.rules = [
    "d /mw 0755 root root -"
    "d /mw/images 0770 www-data www-data -"
    "d /mw/data 0770 mediawiki-db mediawiki-db -"
    "d /mw/redis 0770 mediawiki-redis mediawiki-redis -"
    "d /mw/html 0755 www-data www-data -"
    "d /mw/apache2 0770 root root -"
    "d /mw/run 0770 root root -"
  ];

  systemd.services.mediawiki-redis-auth = {
    description = "Generate the MediaWiki Valkey password and config";
    before = [
      "podman-mediawiki.service"
      "podman-mediawiki-redis.service"
    ] ++ lib.optional mediawiki.enableUpgrade "podman-mediawiki-upgrade.service";
    requiredBy = [
      "podman-mediawiki.service"
      "podman-mediawiki-redis.service"
    ] ++ lib.optional mediawiki.enableUpgrade "podman-mediawiki-upgrade.service";
    after = [ "systemd-tmpfiles-setup.service" ];
    path = [ pkgs.coreutils pkgs.gnugrep ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStart = redisAuthScript;
    };
  };

  # Systemd service to create the pod required by podman containers
  systemd.services.pod-mediawiki = {
    description = "Start podman's 'mediawiki' pod";
    wants = [ "network-online.target" ];
    after = [ "network-online.target" ];
    # requiredBy alone does not order: containers could start before the pod exists.
    before = [
      "podman-mediawiki.service"
      "podman-mediawiki-db.service"
      "podman-mediawiki-redis.service"
    ];
    requiredBy = [
      "podman-mediawiki.service"
      "podman-mediawiki-db.service"
      "podman-mediawiki-redis.service"
    ];
    unitConfig = {
      RequiresMountsFor = "/run/containers";
    };
    serviceConfig = {
      Type = "oneshot";
      Restart = "no";
      ExecStart = pkgs.writeShellScript "pod-mediawiki" ''
        # Publish on loopback only: Caddy is the sole client, and netavark DNATs
        # published ports ahead of nixos-fw, so 0.0.0.0 exposed raw FastCGI to the LAN.
        ${pkgs.podman}/bin/podman pod exists mediawiki || \
        ${pkgs.podman}/bin/podman pod create -p 127.0.0.1:8090:80 -p 127.0.0.1:8091:9000 -h loftiawiki.org \
        --memory 8G --cpus 0 mediawiki
      '';
    };
    path = [ pkgs.podman ];
  };
  systemd.services.pod-mediawiki-upgrade = lib.mkIf mediawiki.enableUpgrade {
    description = "Start podman's 'mediawiki-upgrade' pod";
    wants = [ "network-online.target" ];
    after = [ "network-online.target" ];
    before = [
      "podman-mediawiki-upgrade.service"
      "podman-mediawiki-db.service"
      "podman-mediawiki-redis.service"
    ];
    requiredBy = [
      "podman-mediawiki-upgrade.service"
      "podman-mediawiki-db.service"
      "podman-mediawiki-redis.service"
    ];
    unitConfig = {
      RequiresMountsFor = "/run/containers";
    };
    serviceConfig = {
      Type = "oneshot";
      Restart = "no";
      ExecStart = pkgs.writeShellScript "pod-mediawiki-upgrade" ''
        ${pkgs.podman}/bin/podman pod exists mediawiki-upgrade || \
        ${pkgs.podman}/bin/podman pod create -p 127.0.0.1:8100:80 -p 127.0.0.1:8101:9000 -h upgrade.loftiawiki.org \
        --memory 8G --cpus 0 mediawiki-upgrade
      '';
    };
    path = [ pkgs.podman ];
  };

  # Define the container
  virtualisation.oci-containers.containers = {
    # See mediawiki.enableUpgrade for more info
    "mediawiki-upgrade" = lib.mkIf mediawiki.enableUpgrade {
      autoStart = true;

      user = "root:root";

      volumes = [
        "/etc/passwd:/etc/passwd:ro"
        "/etc/group:/etc/group:ro"
        "/mw/images:/var/www/html/images"
        "/mw/mediawiki-${mediawiki.upgradeVersion}:/var/www/html"
        "/mw/apache2:/etc/apache2"
        "/mw/run:/run"
      ];

      environment = {};

      dependsOn = [ "mediawiki-db" "mediawiki-redis" ];
      extraOptions = [
        "--pod=mediawiki-upgrade"
        "--env-file=${redisAuthDir}/app.env"
      ];

      image = "mediawiki-redis:${mediawiki.upgradeVersion}";
      imageFile = import ./mediawiki-docker.nix {
        inherit pkgs;
        version = mediawiki.upgradeVersion;
        dockerImage = mediawiki.upgradeDockerImage;
      };
    };
    "mediawiki" = {
      autoStart = true;

      # User and group to run the container as
      user = "root:root";

      # Volumes to make persistent in the host/container
      volumes = [
        "/etc/passwd:/etc/passwd:ro"
        "/etc/group:/etc/group:ro"
        "/mw/images:/var/www/html/images"
        "/mw/html:/var/www/html"
        "/mw/apache2:/etc/apache2"
      ];

      environment = {
      };

      dependsOn = [ "mediawiki-db" "mediawiki-redis" ];
      extraOptions = [
        "--pod=mediawiki"
        "--env-file=${redisAuthDir}/app.env"
      ];

      image = "mediawiki-redis:${mediawiki.version}";
      imageFile = import ./mediawiki-docker.nix {
        inherit pkgs;
        version = mediawiki.version;
        dockerImage = mediawiki.dockerImage;
      };
    };
    "mediawiki-db" = {
      autoStart = true;

      # 10004, not the image's built-in `mysql` user (999). See the
      # users.users comment above for why 999 is unsafe on this host.
      user = "10004:10004";

      volumes = [
        "/mw/data:/var/lib/mysql"
      ];

      cmd = ["--transaction-isolation=READ-COMMITTED" "--log-bin=mysqld-bin" "--binlog-format=ROW"];

      environment = {
        MARIADB_DATABASE = "mediawiki";
        MARIADB_USER = "mediawiki";
      };

      dependsOn = [ "mediawiki-redis" ];
      extraOptions = [
        "--pod=mediawiki"
        "--env-file=${config.sops.secrets."mediawiki-environment".path}"
      ];

      image = "docker.io/library/mariadb@sha256:250e1609e93c0e6aecf64bfbab2d84d5e89d2481540fe77447ff6c855c3b1873"; # mariadb 11.4.13
    };
    # Redis is not required, but is a great cache system
    "mediawiki-redis" = {
      autoStart = true;

      # 10005, for the same reason as mediawiki-db above.
      user = "10005:10005";

      volumes = [
        "/mw/redis:/data"
        "${redisAuthDir}/valkey.conf:/etc/valkey-auth.conf:ro"
      ];

      # Pod-local only (MediaWiki reaches it as mediawiki-redis -> 127.0.0.1 via the
      # pod's /etc/hosts), and password-protected via the mounted config file.
      cmd = [ "redis-server" "/etc/valkey-auth.conf" "--bind" "127.0.0.1" "--save" "59" "1" "--loglevel" "warning" ];

      extraOptions = [ "--pod=mediawiki" ];

      image = "docker.io/valkey/valkey@sha256:081c2f5cb575efc901aa80ff9cdbd1ec6a301682fd35e1ebb4b0990a4a4a8507"; # valkey 8.1.10-alpine (BSD fork of Redis; cache/sessions only)
    };
  };
}

