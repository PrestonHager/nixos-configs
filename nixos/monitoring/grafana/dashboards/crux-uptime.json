{
  "uid": "crux-uptime",
  "title": "Crux Service Uptime",
  "tags": ["crux", "uptime", "blackbox", "wings"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 10,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "description": "Crux host service health from ace blackbox probes: Wings HTTPS/API, SFTP file transfer, SSH, and monitoring exporters. Dynamic game ports are not statically probed.",
  "links": [
    { "title": "Network Topology", "type": "dashboard", "url": "/d/network-topology" },
    { "title": "LAN Status", "type": "dashboard", "url": "/d/lan-status" },
    { "title": "Ace Uptime", "type": "dashboard", "url": "/d/ace-uptime" }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health summary",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "title": "Services Up",
      "description": "Essential Crux probes currently succeeding (from ace)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "max": 100,
          "displayName": "${__field.labels.up}/${__field.labels.total}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "green", "value": 100 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "100 * sum(probe_success{job=~\"blackbox-http-crux|blackbox-tcp-crux\",service_tier=\"essential\"}) / count(probe_success{job=~\"blackbox-http-crux|blackbox-tcp-crux\",service_tier=\"essential\"}) * on() group_left(up, total) (count_values(\"up\", sum(probe_success{job=~\"blackbox-http-crux|blackbox-tcp-crux\",service_tier=\"essential\"})) * on() group_left(total) count_values(\"total\", count(probe_success{job=~\"blackbox-http-crux|blackbox-tcp-crux\",service_tier=\"essential\"})))",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "queryType": "instant",
          "range": false,
          "exemplar": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Health Summary",
      "description": "Current essential Crux probe success rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(probe_success{job=~\"blackbox-http-crux|blackbox-tcp-crux\",service_tier=\"essential\"}) / count(probe_success{job=~\"blackbox-http-crux|blackbox-tcp-crux\",service_tier=\"essential\"}) * 100",
          "legendFormat": "current",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Uptime (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "avg(avg_over_time(probe_success{job=~\"blackbox-http-crux|blackbox-tcp-crux\",service_tier=\"essential\"}[24h])) * 100",
          "legendFormat": "24h avg",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Uptime (7d)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "avg(avg_over_time(probe_success{job=~\"blackbox-http-crux|blackbox-tcp-crux\",service_tier=\"essential\"}[7d])) * 100",
          "legendFormat": "7d avg",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Services Down",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "count(probe_success{job=~\"blackbox-http-crux|blackbox-tcp-crux\"} == 0) or vector(0)",
          "legendFormat": "down",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Core services",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "title": "Wings HTTPS",
      "description": "TCP :443 on 192.168.5.6",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-tcp-crux\",service=\"wings\",service_role=\"https\"}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Wings API (HTTP)",
      "description": "HTTPS to crux.lc1… (401 without token = healthy)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-http-crux\",service=\"wings\"}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "File Transfer (SFTP)",
      "description": "Wings SFTP on TCP :2022",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-tcp-crux\",service=\"wings-sftp\"}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "SSH",
      "description": "TCP :22",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-tcp-crux\",service=\"ssh\"}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Blackbox exporter",
      "description": "TCP :9115 (ace-only firewall)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-tcp-crux\",service=\"blackbox\"}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Prometheus",
      "description": "TCP :9090 (ace-only firewall)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-tcp-crux\",service=\"prometheus\"}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "All Crux Services — Status",
      "description": "Current up/down, latency, and 24h/7d uptime per probe",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "inspect": false },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "text": "DOWN", "color": "red", "index": 1 },
                      "1": { "text": "UP", "color": "green", "index": 0 }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "custom.width", "value": 90 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Latency" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 3 },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Uptime 24h" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 95 },
                    { "color": "green", "value": 99 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Uptime 7d" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 95 },
                    { "color": "green", "value": 99 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "displayName": "Status", "desc": false }]
      },
      "targets": [
        {
          "expr": "probe_success{job=~\"blackbox-http-crux|blackbox-tcp-crux\"}",
          "format": "table",
          "instant": true,
          "refId": "status"
        },
        {
          "expr": "probe_duration_seconds{job=~\"blackbox-http-crux|blackbox-tcp-crux\"}",
          "format": "table",
          "instant": true,
          "refId": "latency"
        },
        {
          "expr": "avg_over_time(probe_success{job=~\"blackbox-http-crux|blackbox-tcp-crux\"}[24h]) * 100",
          "format": "table",
          "instant": true,
          "refId": "uptime24h"
        },
        {
          "expr": "avg_over_time(probe_success{job=~\"blackbox-http-crux|blackbox-tcp-crux\"}[7d]) * 100",
          "format": "table",
          "instant": true,
          "refId": "uptime7d"
        }
      ],
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "instance" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "module": true,
              "module 1": true,
              "module 2": true,
              "module 3": true,
              "probe_location": true,
              "probe_location 1": true,
              "probe_location 2": true,
              "probe_location 3": true,
              "service_tier": true,
              "service_tier 1": true,
              "service_tier 2": true,
              "service_tier 3": true,
              "host": true,
              "host 1": true,
              "host 2": true,
              "host 3": true
            },
            "renameByName": {
              "Value #status": "Status",
              "Value #latency": "Latency",
              "Value #uptime24h": "Uptime 24h",
              "Value #uptime7d": "Uptime 7d",
              "instance": "Target",
              "service": "Service",
              "service_role": "Role"
            }
          }
        }
      ]
    },
    {
      "id": 15,
      "title": "Probe success (24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 10, "spanNulls": true }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "probe_success{job=~\"blackbox-http-crux|blackbox-tcp-crux\"}",
          "legendFormat": "{{service}} {{service_role}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "title": "Probe latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "spanNulls": true }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=~\"blackbox-http-crux|blackbox-tcp-crux\"}",
          "legendFormat": "{{service}} {{service_role}}",
          "refId": "A"
        }
      ]
    }
  ]
}
