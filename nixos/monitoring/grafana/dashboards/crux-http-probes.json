{
  "uid": "crux-http-probes",
  "title": "Crux HTTP Probes",
  "tags": ["crux", "http", "blackbox", "lan"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "description": "LAN-perspective HTTP blackbox probes from crux to ace web services (via Technitium DNS).",
  "links": [
    { "title": "Crux Uptime", "type": "dashboard", "url": "/d/crux-uptime" },
    { "title": "LAN Status", "type": "dashboard", "url": "/d/lan-status" }
  ],
  "panels": [
    {
      "id": 1,
      "title": "HTTP LAN Services Up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-crux" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 4 },
              { "color": "green", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        { "expr": "sum(probe_success{job=\"blackbox-http-lan\",module=\"http_2xx\"})", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Uptime (24h avg)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-crux" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        { "expr": "avg(avg_over_time(probe_success{job=\"blackbox-http-lan\",module=\"http_2xx\"}[24h])) * 100", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Non-2xx Responses",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-crux" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        { "expr": "count(probe_http_status_code{job=\"blackbox-http-lan\",module=\"http_2xx\"} < 200 or probe_http_status_code{job=\"blackbox-http-lan\",module=\"http_2xx\"} >= 300) or vector(0)", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Slowest Service",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-crux" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        { "expr": "topk(1, probe_duration_seconds{job=\"blackbox-http-lan\",module=\"http_2xx\"})", "legendFormat": "{{instance}}", "refId": "A", "instant": true }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Service Status",
      "type": "table",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-crux" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "options": { "0": { "color": "red", "index": 1, "text": "DOWN" }, "1": { "color": "green", "index": 0, "text": "UP" } }, "type": "value" }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Latency" },
            "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 3 }]
          },
          {
            "matcher": { "id": "byName", "options": "SSL Expiry (days)" },
            "properties": [
              { "id": "unit", "value": "d" },
              { "id": "decimals", "value": 0 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 14 }, { "color": "green", "value": 30 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Uptime 24h" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 95 }, { "color": "green", "value": 99 }] } }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Latency" }]
      },
      "targets": [
        { "expr": "probe_success{job=\"blackbox-http-lan\",module=\"http_2xx\"}", "format": "table", "instant": true, "refId": "status" },
        { "expr": "probe_duration_seconds{job=\"blackbox-http-lan\",module=\"http_2xx\"}", "format": "table", "instant": true, "refId": "latency" },
        { "expr": "probe_http_status_code{job=\"blackbox-http-lan\",module=\"http_2xx\"}", "format": "table", "instant": true, "refId": "code" },
        { "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-http-lan\",module=\"http_2xx\"} - time()) / 86400", "format": "table", "instant": true, "refId": "ssl" },
        { "expr": "avg_over_time(probe_success{job=\"blackbox-http-lan\",module=\"http_2xx\"}[24h]) * 100", "format": "table", "instant": true, "refId": "uptime" }
      ],
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "instance" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true,
              "__name__": true, "__name__ 1": true, "__name__ 2": true, "__name__ 3": true,
              "job": true, "job 1": true, "job 2": true, "job 3": true,
              "module": true, "module 1": true, "module 2": true, "module 3": true,
              "probe_location": true, "probe_location 1": true, "probe_location 2": true,
              "probe_source": true, "probe_source 1": true, "probe_source 2": true
            },
            "renameByName": {
              "Value #status": "Status",
              "Value #latency": "Latency",
              "Value #code": "HTTP Code",
              "Value #ssl": "SSL Expiry (days)",
              "Value #uptime": "Uptime 24h",
              "instance": "Service"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP Status Codes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus-crux" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "showPoints": "never" }
        }
      },
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "probe_http_status_code{job=\"blackbox-http-lan\",module=\"http_2xx\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "HTTP Duration Breakdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus-crux" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "probe_http_duration_seconds{job=\"blackbox-http-lan\",module=\"http_2xx\",phase=\"resolve\"}", "legendFormat": "{{instance}} resolve", "refId": "A" },
        { "expr": "probe_http_duration_seconds{job=\"blackbox-http-lan\",module=\"http_2xx\",phase=\"connect\"}", "legendFormat": "{{instance}} connect", "refId": "B" },
        { "expr": "probe_http_duration_seconds{job=\"blackbox-http-lan\",module=\"http_2xx\",phase=\"tls\"}", "legendFormat": "{{instance}} tls", "refId": "C" },
        { "expr": "probe_http_duration_seconds{job=\"blackbox-http-lan\",module=\"http_2xx\",phase=\"transfer\"}", "legendFormat": "{{instance}} transfer", "refId": "D" }
      ]
    },
    {
      "id": 8,
      "title": "Probe Success",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus-crux" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 20, "showPoints": "never" }
        }
      },
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "probe_success{job=\"blackbox-http-lan\",module=\"http_2xx\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ]
    }
  ]
}
