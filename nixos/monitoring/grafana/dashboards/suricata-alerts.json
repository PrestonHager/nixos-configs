          "expr": "topk(25, sum by (alert_signature, alert_signature_id, alert_category, alert_severity) (count_over_time({job=\"suricata\"} |~ \"(?i)$filter\" | json | event_type=\"alert\" and alert_severity <= $maxsev and (alert_signature != \"ET SCAN SYN Scan detected\" or src_ip !~ \"192\\\\.168\\\\.5\\\\.([1-9]|1[0-9]|20)\") [$__range])))",
          "refId": "A",
