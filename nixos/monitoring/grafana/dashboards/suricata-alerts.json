{
  "uid": "suricata-alerts",
  "title": "Suricata alerts",
  "tags": [
    "security",
    "suricata",
    "ids"
  ],
  "description": "What triggered the 'Suricata scan or exploit alert' email: sources, signatures, targets and raw events.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "IDS runbook",
      "type": "link",
      "url": "https://serverdocs.prestonhager.com/shared/security-ids-test-cases.html",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "maxsev",
        "label": "Severity",
        "type": "custom",
        "query": "Paging only (1-2) : 2,All severities : 3",
        "current": {
          "text": "Paging only (1-2)",
          "value": "2"
        },
        "options": [
          {
            "text": "Paging only (1-2)",
            "value": "2",
            "selected": true
          },
          {
            "text": "All severities",
            "value": "3",
            "selected": false
          }
        ]
      },
      {
        "name": "filter",
        "label": "Filter (IP, host, signature; regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Alert events",
      "description": "Suricata alert events matching the filters in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"suricata\"} |~ \"(?i)$filter\" | json | event_type=\"alert\" and alert_severity <= $maxsev and (alert_signature != \"ET SCAN SYN Scan detected\" or src_ip !~ \"192\\\\.168\\\\.5\\\\.([1-9]|1[0-9]|20)\") [$__range])) or vector(0)",
          "refId": "A",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Source addresses",
      "description": "Distinct source IPs that triggered alerts.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (src_ip) (count_over_time({job=\"suricata\"} |~ \"(?i)$filter\" | json | event_type=\"alert\" and alert_severity <= $maxsev and (alert_signature != \"ET SCAN SYN Scan detected\" or src_ip !~ \"192\\\\.168\\\\.5\\\\.([1-9]|1[0-9]|20)\") [$__range]))) or vector(0)",
          "refId": "A",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
