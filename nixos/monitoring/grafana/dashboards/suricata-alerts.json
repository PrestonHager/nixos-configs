    {
      "id": 5,
      "type": "timeseries",
      "title": "Alerts over time, by signature",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Bursts line up with the alert email. A steady stream from one signature is usually a scanner or a noisy rule.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (alert_signature) (count_over_time({job=\"suricata\"} |~ \"(?i)$filter\" | json | event_type=\"alert\" and alert_severity <= $maxsev and (alert_signature != \"ET SCAN SYN Scan detected\" or src_ip !~ \"192\\\\.168\\\\.5\\\\.([1-9]|1[0-9]|20)\") [$__auto]))",
          "refId": "A",
          "queryType": "range",
          "range": true,
          "legendFormat": "{{alert_signature}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Who: top sources",
      "description": "Click an address to filter the dashboard to it, or to look it up on AbuseIPDB.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(25, sum by (src_ip) (count_over_time({job=\"suricata\"} |~ \"(?i)$filter\" | json | event_type=\"alert\" and alert_severity <= $maxsev and (alert_signature != \"ET SCAN SYN Scan detected\" or src_ip !~ \"192\\\\.168\\\\.5\\\\.([1-9]|1[0-9]|20)\") [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "src_ip": 0,
              "Value": 1
            },
            "renameByName": {
              "src_ip": "Source IP",
              "Value": "Events"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Events",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Source IP"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show only this source",
                    "url": "/d/suricata-alerts?${__url_time_range}&var-maxsev=${maxsev}&var-filter=${__value.raw}"
                  },
                  {
                    "title": "Look up on AbuseIPDB",
                    "url": "https://www.abuseipdb.com/check/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Events"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-YlRd"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "What: top signatures",
      "description": "Severity 1 = high, 2 = medium (these page). Click a signature to filter to it.",
