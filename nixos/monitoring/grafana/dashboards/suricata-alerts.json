            },
            "indexByName": {
              "alert_signature": 0,
              "alert_signature_id": 1,
              "alert_category": 2,
              "alert_severity": 3,
              "Value": 4
            },
            "renameByName": {
              "alert_signature": "Signature",
              "alert_signature_id": "SID",
              "alert_category": "Category",
              "alert_severity": "Sev",
