# Coolify dashboard and the apps it deploys.
#
#   coolify.prestonhager.com   -> 127.0.0.1:8000/6001/6002 (nixos/containers/coolify.nix)
#   *.apps.prestonhager.com    -> Coolify's proxy on the deploy server (mars:80)
#   any other hostname         -> mars:80 too, when a Coolify app uses it
#
# TLS terminates here, with certificates from the Cloudflare DNS-01 challenge
# in acme-dns.nix (the wildcard needs DNS-01). Coolify's proxy on mars only
# serves plain HTTP on port 80, so apps in Coolify use http://<host> as their
# domain.
#
# The dashboard, its realtime socket (/app/*) and the web terminal
# (/terminal/ws) answer only the LAN, the tailnet and WireGuard clients
# (lib.nix lanRanges); anyone else gets 403. Two paths are reachable from
# outside:
#   /webhooks/*  anyone: GitHub (App and manual webhooks) triggers deploys;
#                Coolify verifies those requests with the webhook secret.
#   /api/*       lanRanges plus GitHub-hosted Actions runners (`githubActionsApi`
#                below): Animal Search's deploy workflow runs on them and calls
#                the token-authenticated API. The runner ranges are the
#                `actions` list of https://api.github.com/meta, refreshed by
#                coolify-github-actions-ips (every 6 h) into
#                /var/lib/coolify-github-actions/matcher.caddy.
#                Those are shared Azure/GitHub addresses, so any GitHub
#                workflow can connect; the API token is still what authorizes.
#
# The catch-all sites below only match hostnames that no other vhost on ace
# claims (Caddy prefers the most specific host). HTTPS certificates for them
# are issued on demand, after coolify-edge-ask (nixos/containers/coolify-edge.nix)
# confirms that a Coolify app uses the name; everything else fails the TLS
# handshake. Those app sites stay public on purpose: they are the apps.
{ config, lib, pkgs, ... }:

let
  caddyLib = import ./lib.nix;
  # Let GitHub-hosted Actions runners (and the LAN) reach Coolify's API.
  # false = the API is LAN-only, like the dashboard.
  githubActionsApi = true;

  githubActionsDir = "/var/lib/coolify-github-actions";
  # Defines @github_actions; imported by the vhost at (re)load time.
  githubActionsMatcher = "${githubActionsDir}/matcher.caddy";
  # Until the first successful fetch: TEST-NET-1, never a real peer, so the
  # API stays closed to the internet rather than Caddy failing to start.
  githubActionsPlaceholder = "@github_actions remote_ip 192.0.2.0/32";

  updateGithubActionsIps = pkgs.writeShellApplication {
    name = "coolify-github-actions-ips";
    runtimeInputs = with pkgs; [ coreutils diffutils gnugrep gnused curl jq systemd config.services.caddy.package ];
    text = ''
      tmp=$(mktemp -d)
      trap 'rm -rf "$tmp"' EXIT

      curl -fsS --retry 3 --max-time 60 https://api.github.com/meta -o "$tmp/meta.json"
      jq -r '.actions[]' "$tmp/meta.json" > "$tmp/ranges"

      # GitHub lists thousands; a short list means a broken response, and an
      # empty one would make remote_ip invalid. Keep the current file.
      count=$(wc -l < "$tmp/ranges")
      if [ "$count" -lt 100 ]; then
        echo "only $count ranges in api.github.com/meta .actions; keeping current list" >&2
        exit 1
      fi
      if grep -qvE '^[0-9A-Fa-f:.]+/[0-9]+$' "$tmp/ranges"; then
        echo "unexpected entry in .actions; keeping current list" >&2
        exit 1
      fi

      {
        echo "# Generated by coolify-github-actions-ips from api.github.com/meta (.actions)."
        echo "@github_actions {"
        sed 's/^/  remote_ip /' "$tmp/ranges"
        echo "}"
      } > "$tmp/matcher.caddy"

      # Let Caddy parse and provision the matcher before it goes live, so a
      # bad list can never break the next reload or restart.
      cat > "$tmp/Caddyfile" <<EOF
      {
        admin off
        auto_https off
        storage file_system $tmp/storage
      }
      http://localhost:1 {
        import $tmp/matcher.caddy
        respond @github_actions 204
      }
      EOF
      if ! out=$(HOME=$tmp caddy validate --adapter caddyfile --config "$tmp/Caddyfile" 2>&1); then
        echo "$out" >&2
        echo "caddy rejected the generated matcher; keeping current list" >&2
        exit 1
      fi

      if cmp -s "$tmp/matcher.caddy" ${githubActionsMatcher}; then
        echo "$count ranges, unchanged"
        exit 0
      fi
      install -m 0644 "$tmp/matcher.caddy" ${githubActionsMatcher}.new
      mv ${githubActionsMatcher}.new ${githubActionsMatcher}
      echo "$count ranges, updated; reloading caddy"
      systemctl reload caddy.service
    '';
  };

  # Traefik routes on Host; Caddy already sends X-Forwarded-Proto/Host/For.
  proxyToApps = ''
    reverse_proxy 192.168.5.15:80
  '';
in
{
  services.caddy.virtualHosts = {
    "coolify.prestonhager.com".extraConfig = ''
      ${caddyLib.securityHeaders}

      # Public: GitHub App / manual webhooks (signed by the webhook secret).
      handle /webhooks/* {
        reverse_proxy 127.0.0.1:8000
      }
      ${lib.optionalString githubActionsApi ''
        # API: GitHub-hosted Actions runners and the LAN (@homelab_lan is
        # defined by lanOnly below); everyone else 403.
        import ${githubActionsMatcher}
        handle /api/* {
          handle @github_actions {
            reverse_proxy 127.0.0.1:8000
          }
          handle @homelab_lan {
            reverse_proxy 127.0.0.1:8000
          }
          handle {
            respond "Forbidden" 403
          }
        }
      ''}

      ${caddyLib.lanOnly ''
        # Realtime (Laravel Reverb / Pusher protocol) and the web terminal.
        handle /app/* {
          reverse_proxy 127.0.0.1:6001
        }
        handle /terminal/ws {
          reverse_proxy 127.0.0.1:6002
        }
        handle {
          reverse_proxy 127.0.0.1:8000
        }
      ''}
    '';

    "*.apps.prestonhager.com".extraConfig = proxyToApps;

    # The default per-vhost log name would be access-https:__.log, which
    # Caddy fails to open, so these two name their logs explicitly.
    "https://" = {
      logFormat = "output file /var/log/caddy/access-catchall-https.log";
      extraConfig = ''
        tls {
          on_demand
        }
        ${proxyToApps}
      '';
    };

    # Plain HTTP for names no other vhost claims: send it to HTTPS, where the
    # on-demand check decides. Named vhosts keep their own redirects.
    "http://" = {
      logFormat = "output file /var/log/caddy/access-catchall-http.log";
      extraConfig = ''
        redir https://{host}{uri} 308
      '';
    };
  };

  # The matcher file must exist before Caddy loads the vhost; `f` only writes
  # the placeholder when the file is missing, never over a fetched list.
  systemd.tmpfiles.rules = lib.optionals githubActionsApi [
    "d ${githubActionsDir} 0755 root root -"
    "f ${githubActionsMatcher} 0644 root root - ${githubActionsPlaceholder}"
  ];

  systemd.services.coolify-github-actions-ips = lib.mkIf githubActionsApi {
    description = "Refresh GitHub Actions runner ranges allowed to reach the Coolify API";
    wants = [ "network-online.target" ];
    after = [ "network-online.target" "caddy.service" ];
    # Also on boot and on every switch, so a fresh host opens the API quickly.
    wantedBy = [ "multi-user.target" ];
    serviceConfig = {
      Type = "oneshot";
      ExecStart = lib.getExe updateGithubActionsIps;
      PrivateTmp = true;
      ProtectHome = true;
      ProtectSystem = "strict";
      ReadWritePaths = [ githubActionsDir ];
    };
  };

  systemd.timers.coolify-github-actions-ips = lib.mkIf githubActionsApi {
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnCalendar = "*-*-* 00/6:00:00";
      RandomizedDelaySec = "15m";
      Persistent = true;
    };
  };
}
