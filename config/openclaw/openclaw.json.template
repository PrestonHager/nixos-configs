{
  // Template for /stor/openclaw/.openclaw/openclaw.json on ace.
  // Apply with: bash scripts/ace-openclaw-config.sh [model]
  // SSO: Caddy + oauth2-proxy (Zitadel) → trusted-proxy auth. See docs/ace-openclaw-sso.md
  gateway: {
    mode: "local",
    trustedProxies: ["127.0.0.1"],
    auth: {
      mode: "trusted-proxy",
      trustedProxy: {
        userHeader: "x-forwarded-email",
        allowLoopback: true,
        requiredHeaders: ["x-forwarded-proto", "x-forwarded-host"],
      },
    },
    controlUi: {
      allowedOrigins: ["https://ai.prestonhager.com"],
    },
  },
  env: {
    vars: {
      OLLAMA_API_KEY: "ollama-local",
    },
  },
  models: {
    providers: {
      ollama: {
        baseUrl: "http://127.0.0.1:11434",
        apiKey: "ollama-local",
        api: "ollama",
        models: [
          {
            id: "llama3.2:3b",
            name: "Llama 3.2 3B",
            contextWindow: 131072,
            maxTokens: 4096,
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      // gemma2:2b (8192 ctx) cannot fit OpenClaw's ~8.8k-token base prompt; use llama3.2:3b on K80.
      model: "ollama/llama3.2:3b",
      compaction: {
        reserveTokens: 2048,
        reserveTokensFloor: 0,
      },
    },
  },
}
